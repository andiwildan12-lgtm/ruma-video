{"K": {"celah": 4.54, "sehat": 12.62, "lewat": 15.18, "kok": 18.78, "c1": 20.46, "c2": 25.02, "c3": 28.14, "c4": 32.46, "kunyah": 36.54, "kuman": 42.14, "darah": 45.5, "tanda": 48.7, "cara": 53.34, "cungkil": 58.7, "rutin": 61.66, "tutup": 66.22, "periksa": 68.86, "cta": 76.7, "tulis": 78.62, "fol1": 7.9, "follow": 81.9, "card": 86.9, "total": 90.1}, "subs": [[0.3, 3.18, "Gigi paling belakang justru paling sering jadi tempat"], [3.26, 4.14, "makanan nyangkut."], [4.54, 7.34, "Biasanya ada <b>celah</b> yang nggak seharusnya ada."], [7.9, 10.78, "Follow, tiap dua hari satu hal soal gigi"], [10.86, 12.34, "yang jarang dibahas."], [12.62, 14.86, "Gigi yang sehat saling menempel <b>rapat.</b>"], [15.18, 17.34, "Makanan yang dikunyah <b>meluncur</b> lewat,"], [17.38, 18.58, "nggak masuk ke sela."], [18.78, 20.18, "Kok bisa jadi <b>renggang?</b>"], [20.46, 22.78, "Satu, ada <b>lubang</b> di sisi gigi,"], [22.94, 24.62, "yang nggak kelihatan dari atas."], [25.02, 27.82, "Dua, <b>tambalan</b> yang bentuknya kurang pas."], [28.14, 31.26, "Tiga, gigi <b>bungsu</b> yang tumbuh miring atau baru"], [31.34, 32.3, "keluar setengah."], [32.46, 35.66, "Empat, gigi bergeser karena ada gigi yang sudah"], [35.74, 36.22, "<b>dicabut.</b>"], [36.54, 39.74, "Lalu tiap mengunyah, <b>serat</b> makanan terdorong masuk ke"], [39.82, 41.94, "<b>celah</b> itu dan tertahan di gusi."], [42.14, 45.34, "Kuman memakannya, gusi di sela itu <b>meradang.</b>"], [45.5, 48.5, "Makanya pas dibersihkan, gusinya <b>berdarah.</b>"], [48.7, 50.7, "Darahnya tanda gusi meradang,"], [50.78, 52.94, "bukan tanda harus <b>berhenti</b> membersihkan."], [53.34, 53.9, "Caranya:"], [54.3, 57.66, "setelah makan, bersihkan pelan dengan <b>benang</b> gigi atau"], [57.74, 58.38, "<b>sikat</b> sela."], [58.7, 61.34, "Jangan <b>dicungkil</b> pakai tusuk gigi atau peniti."], [61.66, 65.22, "Kalau rutin, berdarahnya biasanya berkurang dalam satu sampai"], [65.26, 65.9, "dua <b>minggu.</b>"], [66.22, 68.7, "Tapi celahnya nggak akan menutup <b>sendiri.</b>"], [68.86, 71.58, "Periksa ke <b>dokter</b> gigi untuk cari penyebabnya:"], [71.62, 74.22, "<b>lubang</b> ditambal, <b>tambalan</b> diperbaiki,"], [74.38, 76.3, "atau gigi bungsunya dievaluasi."], [76.7, 78.3, "Mau dibahas apa lagi soal gigi?"], [78.62, 81.5, "Tulis di <b>komentar,</b> nanti kita jawab lewat video."], [81.9, 84.78, "Follow, tiap dua hari satu hal soal gigi"], [84.86, 86.3, "yang jarang dibahas."]], "words": [[0.3, 0.62, "Gigi"], [0.7, 0.86, "paling"], [0.94, 1.42, "belakang"], [1.58, 1.98, "justru"], [2.02, 2.3, "paling"], [2.38, 2.62, "sering"], [2.7, 2.78, "jadi"], [2.86, 3.18, "tempat"], [3.26, 3.5, "makanan"], [3.58, 4.14, "nyangkut."], [4.54, 5.18, "Biasanya"], [5.34, 5.5, "ada"], [5.58, 5.98, "celah"], [6.06, 6.14, "yang"], [6.22, 6.38, "nggak"], [6.46, 6.94, "seharusnya"], [7.1, 7.34, "ada."], [7.9, 8.7, "Follow,"], [8.78, 8.94, "tiap"], [9.02, 9.14, "dua"], [9.18, 9.5, "hari"], [9.58, 9.82, "satu"], [9.9, 10.06, "hal"], [10.14, 10.38, "soal"], [10.42, 10.78, "gigi"], [10.86, 11.02, "yang"], [11.1, 11.42, "jarang"], [11.46, 12.34, "dibahas."], [12.62, 12.86, "Gigi"], [12.94, 13.02, "yang"], [13.1, 13.5, "sehat"], [13.58, 13.9, "saling"], [13.98, 14.3, "menempel"], [14.38, 14.86, "rapat."], [15.18, 15.5, "Makanan"], [15.58, 15.66, "yang"], [15.713, 16.22, "dikunyah"], [16.3, 16.7, "meluncur"], [16.78, 17.34, "lewat,"], [17.38, 17.54, "nggak"], [17.58, 17.9, "masuk"], [17.94, 17.98, "ke"], [18.06, 18.58, "sela."], [18.78, 18.94, "Kok"], [18.98, 19.18, "bisa"], [19.26, 19.34, "jadi"], [19.42, 20.18, "renggang?"], [20.46, 21.18, "Satu,"], [21.3, 21.42, "ada"], [21.5, 21.82, "lubang"], [21.9, 21.98, "di"], [22.02, 22.22, "sisi"], [22.3, 22.78, "gigi,"], [22.94, 23.1, "yang"], [23.14, 23.26, "nggak"], [23.34, 23.82, "kelihatan"], [23.9, 24.06, "dari"], [24.14, 24.62, "atas."], [25.02, 25.42, "Dua,"], [25.74, 26.3, "tambalan"], [26.38, 26.46, "yang"], [26.54, 26.94, "bentuknya"], [27.02, 27.26, "kurang"], [27.34, 27.82, "