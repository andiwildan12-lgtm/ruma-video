{"K": {"celah": 4.54, "sehat": 9.39, "lewat": 11.95, "kok": 15.55, "c1": 17.23, "c2": 21.79, "c3": 24.91, "c4": 29.23, "kunyah": 33.31, "kuman": 38.91, "darah": 42.27, "tanda": 45.47, "cara": 50.11, "cungkil": 55.47, "rutin": 58.43, "tutup": 62.99, "periksa": 65.63, "cta": 73.47, "tulis": 75.39, "fol1": 7.8, "follow": 78.57, "card": 80.47, "total": 83.67}, "subs": [[0.3, 3.18, "Gigi paling belakang justru paling sering jadi tempat"], [3.26, 4.14, "makanan nyangkut."], [4.54, 7.34, "Biasanya ada <b>celah</b> yang nggak seharusnya ada."], [7.8, 9.02, "Follow Dalam Gigi, ya."], [9.39, 11.63, "Gigi yang sehat saling menempel <b>rapat.</b>"], [11.95, 14.11, "Makanan yang dikunyah <b>meluncur</b> lewat,"], [14.15, 15.35, "nggak masuk ke sela."], [15.55, 16.95, "Kok bisa jadi <b>renggang?</b>"], [17.23, 19.55, "Satu, ada <b>lubang</b> di sisi gigi,"], [19.71, 21.39, "yang nggak kelihatan dari atas."], [21.79, 24.59, "Dua, <b>tambalan</b> yang bentuknya kurang pas."], [24.91, 28.03, "Tiga, gigi <b>bungsu</b> yang tumbuh miring atau baru"], [28.11, 29.07, "keluar setengah."], [29.23, 32.43, "Empat, gigi bergeser karena ada gigi yang sudah"], [32.51, 32.99, "<b>dicabut.</b>"], [33.31, 36.51, "Lalu tiap mengunyah, <b>serat</b> makanan terdorong masuk ke"], [36.59, 38.71, "<b>celah</b> itu dan tertahan di gusi."], [38.91, 42.11, "Kuman memakannya, gusi di sela itu <b>meradang.</b>"], [42.27, 45.27, "Makanya pas dibersihkan, gusinya <b>berdarah.</b>"], [45.47, 47.47, "Darahnya tanda gusi meradang,"], [47.55, 49.71, "bukan tanda harus <b>berhenti</b> membersihkan."], [50.11, 50.67, "Caranya:"], [51.07, 54.43, "setelah makan, bersihkan pelan dengan <b>benang</b> gigi atau"], [54.51, 55.15, "<b>sikat</b> sela."], [55.47, 58.11, "Jangan <b>dicungkil</b> pakai tusuk gigi atau peniti."], [58.43, 61.99, "Kalau rutin, berdarahnya biasanya berkurang dalam satu sampai"], [62.03, 62.67, "dua <b>minggu.</b>"], [62.99, 65.47, "Tapi celahnya nggak akan menutup <b>sendiri.</b>"], [65.63, 68.35